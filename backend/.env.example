# Application Settings
APP_NAME="Project Delivery Management System"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 18)
POSTGRES_SERVER=localhost
POSTGRES_PORT=6789
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=project_delivery_db

# SQLAlchemy Database URL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:6789/project_delivery_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False
